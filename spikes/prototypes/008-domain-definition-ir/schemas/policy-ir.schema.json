{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://allotey.ai/schemas/ir/policy-ir.schema.json",
  "title": "Policy IR",
  "description": "Defines attribute-based rules, compliance constraints, data governance policies, and business rules that transcend simple authorization.",
  "type": "object",
  "required": ["policies"],
  "additionalProperties": false,
  "properties": {
    "policies": {
      "type": "array",
      "description": "All policies in the domain.",
      "items": { "$ref": "#/definitions/policy" },
      "minItems": 1
    },
    "complianceFrameworks": {
      "type": "array",
      "description": "Named compliance frameworks that policies can reference.",
      "items": { "$ref": "#/definitions/complianceFramework" }
    }
  },
  "definitions": {
    "policy": {
      "type": "object",
      "required": ["name", "type", "rules"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique policy identifier.",
          "pattern": "^[a-z][a-z_0-9]*$"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Category of policy.",
          "enum": [
            "data_governance",
            "business_rule",
            "compliance",
            "validation",
            "retention",
            "audit"
          ]
        },
        "priority": {
          "type": "integer",
          "description": "Evaluation priority. Higher values take precedence.",
          "minimum": 0,
          "default": 0
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this policy is currently active.",
          "default": true
        },
        "scope": {
          "$ref": "#/definitions/policyScope",
          "description": "What this policy applies to."
        },
        "rules": {
          "type": "array",
          "description": "Rules within this policy.",
          "items": { "$ref": "#/definitions/rule" },
          "minItems": 1
        },
        "complianceRef": {
          "type": "string",
          "description": "Reference to a compliance framework this policy implements."
        },
        "tags": {
          "type": "array",
          "description": "Classification tags (e.g., 'hipaa', 'gdpr', 'pci').",
          "items": { "type": "string" }
        },
        "effectiveFrom": {
          "type": "string",
          "description": "ISO 8601 date when this policy becomes effective.",
          "format": "date"
        },
        "effectiveUntil": {
          "type": "string",
          "description": "ISO 8601 date when this policy expires.",
          "format": "date"
        }
      }
    },
    "policyScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "description": "Entity types this policy applies to.",
          "items": { "type": "string" }
        },
        "roles": {
          "type": "array",
          "description": "Roles this policy applies to.",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "description": "Actions this policy governs.",
          "items": { "type": "string" }
        },
        "properties": {
          "type": "array",
          "description": "Specific properties this policy governs.",
          "items": { "type": "string" }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["name", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable rule name."
        },
        "description": {
          "type": "string"
        },
        "when": {
          "$ref": "#/definitions/ruleCondition",
          "description": "Condition that triggers this rule."
        },
        "then": {
          "$ref": "#/definitions/ruleAction",
          "description": "Action to take when condition is met."
        },
        "severity": {
          "type": "string",
          "description": "How strictly this rule is enforced.",
          "enum": ["error", "warning", "info"],
          "default": "error"
        },
        "message": {
          "type": "string",
          "description": "Message to display when rule is triggered."
        }
      }
    },
    "ruleCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "description": "All conditions must be true (AND).",
          "items": { "$ref": "#/definitions/ruleCondition" }
        },
        "any": {
          "type": "array",
          "description": "At least one condition must be true (OR).",
          "items": { "$ref": "#/definitions/ruleCondition" }
        },
        "not": {
          "$ref": "#/definitions/ruleCondition",
          "description": "Negates the condition."
        },
        "attribute": {
          "type": "string",
          "description": "Attribute path to evaluate (e.g., 'entity.status', 'user.role', 'context.time')."
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "not_equals",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "contains",
            "matches",
            "is_set",
            "is_not_set",
            "between",
            "older_than",
            "newer_than"
          ]
        },
        "value": {
          "description": "Value to compare against."
        },
        "expression": {
          "type": "string",
          "description": "Free-form boolean expression for complex conditions."
        }
      }
    },
    "ruleAction": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of action to take.",
          "enum": [
            "deny",
            "allow",
            "require_approval",
            "mask_field",
            "redact_field",
            "encrypt_field",
            "log_access",
            "notify",
            "flag_for_review",
            "set_retention",
            "transform"
          ]
        },
        "fields": {
          "type": "array",
          "description": "Fields affected by the action.",
          "items": { "type": "string" }
        },
        "maskPattern": {
          "type": "string",
          "description": "Pattern for masking (e.g., '***-**-{last4}')."
        },
        "retentionDays": {
          "type": "integer",
          "description": "Number of days to retain data.",
          "minimum": 1
        },
        "notifyRoles": {
          "type": "array",
          "description": "Roles to notify when the rule triggers.",
          "items": { "type": "string" }
        },
        "approvalRoles": {
          "type": "array",
          "description": "Roles that must approve the action.",
          "items": { "type": "string" }
        },
        "transformExpression": {
          "type": "string",
          "description": "Expression defining the transformation to apply."
        },
        "metadata": {
          "type": "object",
          "description": "Additional key-value data for the action.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "complianceFramework": {
      "type": "object",
      "required": ["name", "controls"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Framework identifier (e.g., 'hipaa', 'gdpr', 'sox').",
          "pattern": "^[a-z][a-z_0-9]*$"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Version of the framework."
        },
        "controls": {
          "type": "array",
          "description": "Named controls within the framework.",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Control identifier (e.g., 'HIPAA-164.312(a)(1)')."
              },
              "description": {
                "type": "string"
              },
              "implementedBy": {
                "type": "array",
                "description": "Policy names that implement this control.",
                "items": { "type": "string" }
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
