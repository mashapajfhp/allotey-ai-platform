{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://allotey.ai/schemas/ir/workflow-ir.schema.json",
  "title": "Workflow IR",
  "description": "Defines multi-step processes, state machines, approval chains, and orchestration flows for the domain.",
  "type": "object",
  "required": ["workflows"],
  "additionalProperties": false,
  "properties": {
    "workflows": {
      "type": "array",
      "description": "All workflows in the domain.",
      "items": { "$ref": "#/definitions/workflow" },
      "minItems": 1
    }
  },
  "definitions": {
    "workflow": {
      "type": "object",
      "required": ["name", "trigger", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique workflow identifier.",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "description": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "description": "Primary entity this workflow operates on.",
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        },
        "trigger": {
          "$ref": "#/definitions/workflowTrigger",
          "description": "What starts this workflow."
        },
        "input": {
          "type": "array",
          "description": "Input parameters for the workflow.",
          "items": { "$ref": "#/definitions/workflowParam" }
        },
        "steps": {
          "type": "array",
          "description": "Ordered steps in the workflow.",
          "items": { "$ref": "#/definitions/step" },
          "minItems": 1
        },
        "onFailure": {
          "$ref": "#/definitions/failureHandler",
          "description": "What to do when the workflow fails."
        },
        "timeout": {
          "type": "string",
          "description": "Maximum duration for the entire workflow (ISO 8601 duration)."
        },
        "maxRetries": {
          "type": "integer",
          "description": "Maximum retry attempts for the entire workflow.",
          "minimum": 0,
          "default": 0
        },
        "idempotencyKey": {
          "type": "string",
          "description": "Property or expression used to deduplicate workflow executions."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "workflowTrigger": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "What initiates the workflow.",
          "enum": ["event", "action", "schedule", "manual", "api"]
        },
        "event": {
          "type": "string",
          "description": "Event name for 'event' triggers."
        },
        "action": {
          "type": "string",
          "description": "Action name for 'action' triggers."
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression for 'schedule' triggers."
        },
        "condition": {
          "type": "string",
          "description": "Additional condition that must be true to start the workflow."
        }
      }
    },
    "workflowParam": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "date", "timestamp", "reference"]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "default": {
          "description": "Default value."
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique step name within the workflow.",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Type of step.",
          "enum": [
            "action",
            "approval",
            "condition",
            "parallel",
            "wait",
            "notify",
            "transform",
            "loop",
            "sub_workflow",
            "agent_task"
          ]
        },
        "action": {
          "type": "string",
          "description": "Action name for 'action' steps."
        },
        "inputMapping": {
          "type": "object",
          "description": "Mapping from workflow context to step input.",
          "additionalProperties": { "type": "string" }
        },
        "outputMapping": {
          "type": "object",
          "description": "Mapping from step output to workflow context.",
          "additionalProperties": { "type": "string" }
        },
        "approval": {
          "$ref": "#/definitions/approvalConfig",
          "description": "Configuration for 'approval' steps."
        },
        "condition": {
          "$ref": "#/definitions/conditionConfig",
          "description": "Configuration for 'condition' steps."
        },
        "parallel": {
          "$ref": "#/definitions/parallelConfig",
          "description": "Configuration for 'parallel' steps."
        },
        "wait": {
          "$ref": "#/definitions/waitConfig",
          "description": "Configuration for 'wait' steps."
        },
        "notify": {
          "$ref": "#/definitions/notifyConfig",
          "description": "Configuration for 'notify' steps."
        },
        "loop": {
          "$ref": "#/definitions/loopConfig",
          "description": "Configuration for 'loop' steps."
        },
        "subWorkflow": {
          "type": "string",
          "description": "Workflow name for 'sub_workflow' steps."
        },
        "agentTask": {
          "$ref": "#/definitions/agentTaskConfig",
          "description": "Configuration for 'agent_task' steps."
        },
        "transform": {
          "$ref": "#/definitions/transformConfig",
          "description": "Configuration for 'transform' steps."
        },
        "onFailure": {
          "$ref": "#/definitions/failureHandler"
        },
        "timeout": {
          "type": "string",
          "description": "Step-level timeout (ISO 8601 duration)."
        },
        "retryPolicy": {
          "$ref": "#/definitions/retryPolicy"
        },
        "next": {
          "type": "string",
          "description": "Next step name. If omitted, proceeds to the next step in the array."
        }
      }
    },
    "approvalConfig": {
      "type": "object",
      "required": ["approvers"],
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "type": "array",
          "description": "Roles or specific users who can approve.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "strategy": {
          "type": "string",
          "description": "How many approvals are needed.",
          "enum": ["any_one", "all", "majority", "threshold"],
          "default": "any_one"
        },
        "threshold": {
          "type": "integer",
          "description": "Number of approvals required for 'threshold' strategy.",
          "minimum": 1
        },
        "escalateAfter": {
          "type": "string",
          "description": "Duration after which to escalate (ISO 8601)."
        },
        "escalateTo": {
          "type": "array",
          "description": "Roles to escalate to.",
          "items": { "type": "string" }
        },
        "onApprove": {
          "type": "string",
          "description": "Next step when approved."
        },
        "onReject": {
          "type": "string",
          "description": "Next step when rejected."
        },
        "onTimeout": {
          "type": "string",
          "description": "Next step on timeout.",
          "enum": ["auto_approve", "auto_reject", "escalate", "fail"]
        }
      }
    },
    "conditionConfig": {
      "type": "object",
      "required": ["expression"],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string",
          "description": "Boolean expression to evaluate."
        },
        "onTrue": {
          "type": "string",
          "description": "Next step when expression is true."
        },
        "onFalse": {
          "type": "string",
          "description": "Next step when expression is false."
        },
        "branches": {
          "type": "array",
          "description": "Multiple branches for switch-like logic.",
          "items": {
            "type": "object",
            "required": ["value", "next"],
            "additionalProperties": false,
            "properties": {
              "value": { "description": "Value to match." },
              "next": { "type": "string" }
            }
          }
        }
      }
    },
    "parallelConfig": {
      "type": "object",
      "required": ["branches"],
      "additionalProperties": false,
      "properties": {
        "branches": {
          "type": "array",
          "description": "Steps to execute in parallel.",
          "items": {
            "type": "object",
            "required": ["steps"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "steps": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          },
          "minItems": 2
        },
        "joinStrategy": {
          "type": "string",
          "description": "When to proceed after parallel branches.",
          "enum": ["wait_all", "wait_any", "wait_n"],
          "default": "wait_all"
        },
        "waitCount": {
          "type": "integer",
          "description": "Number of branches to wait for in 'wait_n' strategy.",
          "minimum": 1
        }
      }
    },
    "waitConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string",
          "description": "Fixed duration to wait (ISO 8601 duration)."
        },
        "until": {
          "type": "string",
          "description": "Wait until this condition becomes true."
        },
        "forEvent": {
          "type": "string",
          "description": "Event name to wait for."
        },
        "timeout": {
          "type": "string",
          "description": "Maximum wait time (ISO 8601 duration)."
        },
        "onTimeout": {
          "type": "string",
          "description": "Next step if timeout is reached."
        }
      }
    },
    "notifyConfig": {
      "type": "object",
      "required": ["recipients", "template"],
      "additionalProperties": false,
      "properties": {
        "recipients": {
          "type": "array",
          "description": "Roles or expressions that resolve to recipients.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "template": {
          "type": "string",
          "description": "Notification template name or inline message."
        },
        "channel": {
          "type": "string",
          "description": "Notification channel.",
          "enum": ["email", "sms", "push", "in_app", "webhook"]
        },
        "parameters": {
          "type": "object",
          "description": "Template parameters.",
          "additionalProperties": true
        }
      }
    },
    "loopConfig": {
      "type": "object",
      "required": ["collection", "steps"],
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string",
          "description": "Expression that resolves to an array to iterate over."
        },
        "itemVariable": {
          "type": "string",
          "description": "Variable name for the current item.",
          "default": "item"
        },
        "steps": {
          "type": "array",
          "description": "Steps to execute for each item.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "maxIterations": {
          "type": "integer",
          "description": "Safety limit on iterations.",
          "minimum": 1,
          "default": 1000
        },
        "parallel": {
          "type": "boolean",
          "description": "Whether to process items in parallel.",
          "default": false
        }
      }
    },
    "agentTaskConfig": {
      "type": "object",
      "required": ["capability", "prompt"],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "description": "Agent capability name to invoke."
        },
        "prompt": {
          "type": "string",
          "description": "Prompt template for the agent task."
        },
        "tools": {
          "type": "array",
          "description": "Actions the agent can use during this task.",
          "items": { "type": "string" }
        },
        "maxSteps": {
          "type": "integer",
          "description": "Maximum reasoning steps.",
          "minimum": 1,
          "default": 10
        },
        "outputSchema": {
          "type": "object",
          "description": "Expected output structure.",
          "additionalProperties": true
        }
      }
    },
    "transformConfig": {
      "type": "object",
      "required": ["mappings"],
      "additionalProperties": false,
      "properties": {
        "mappings": {
          "type": "object",
          "description": "Key-value mappings from source expressions to target context variables.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "failureHandler": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "description": "Failure handling strategy.",
          "enum": ["fail", "retry", "compensate", "skip", "fallback"]
        },
        "compensateAction": {
          "type": "string",
          "description": "Action to invoke for compensation."
        },
        "fallbackStep": {
          "type": "string",
          "description": "Step to jump to as fallback."
        },
        "notifyRoles": {
          "type": "array",
          "description": "Roles to notify on failure.",
          "items": { "type": "string" }
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "backoffType": {
          "type": "string",
          "enum": ["fixed", "exponential", "linear"],
          "default": "exponential"
        },
        "initialInterval": {
          "type": "string",
          "description": "Initial retry interval (ISO 8601 duration).",
          "default": "PT1S"
        },
        "maxInterval": {
          "type": "string",
          "description": "Maximum retry interval (ISO 8601 duration).",
          "default": "PT5M"
        }
      }
    }
  }
}
